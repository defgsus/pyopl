Screen {
    layout: vertical;
}

#info {
    height: auto;
    padding: 0 1;
    background: $surface;
    border-bottom: solid $primary;
}


Footer {
    height: 1;
}

PatternEditor {
    height: 1fr;
    border: solid $primary;
    color: #ddd;
    & .pattern--header {
        background: #464;
    }
    & .pattern--header-playback-row {
        background: #797;
        color: #fff;
    }
    & .pattern--highlight {
        background: #444;
        color: #fff;
    }
    & .pattern--playback-row {
        background: #343;
        color: #eee;
    }
    & .pattern--selected {
        background: #346;
    }
    & .pattern--cursor {
        background: #776;
        color: #fff;
    }
    & .pattern--cursor-selected {
        background: #78a;
        color: #fff;
    }
}
